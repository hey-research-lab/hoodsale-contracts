# Environment of the HoodSale launch keeper service (/etc/hoodsale/keeper.env on the server).
# Keep this file readable by root and the hoodsale user only (mode 640).
KEEPER_KEY=0x...
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# Verification of newly created tokens and presale contracts on Sourcify (1 on, 0 off)
AUTO_VERIFY=1
# Presale contracts are verified too unless this is 0
VERIFY_PRESALES=1
POLL_SECONDS=15
# Reward distribution guards (see scripts/launch-keeper.js for the defaults)
# REWARDS_INTERVAL_SECONDS=300
# REWARDS_MAX_IMPACT_BPS=2000
# REWARDS_SLIPPAGE_BPS=300
# Uniswap v4 fee mode: selling the collected token fees for ETH (see scripts/launch-keeper.js).
# Fee mode is on when deployments/<network>.json has v4FeeLauncher and v4FeeHook; the quoter is
# read from its v4Quoter.
# The defaults are shown; a line is only needed to change one.
# V4_FEE_CONVERT_MIN_ETH=0.0005
# V4_FEE_BACKLOG_MIN_ETH=0.0001
# V4_FEE_SLIPPAGE_BPS=100
# Shared by both v4 modes: the ETH a pool must have collected before a flush is sent.
# V4_FLUSH_MIN_ETH=0.005
